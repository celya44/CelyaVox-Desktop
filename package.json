{
  "name": "CelyaVox",
  "version": "1.1.1",
  "description": "Electron wrapper for CelyaVox",
  "repository": {
    "type": "git",
    "url": "https://github.com/celya44/CelyaVox-Desktop"
  },
  "main": "main.js",
  "config": {
    "environment": "prod"
  },
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu",
    "start:dev": "cross-env APP_ENV=dev electron . --no-sandbox --disable-gpu",
    "start:prod": "cross-env APP_ENV=prod electron . --no-sandbox --disable-gpu",
    "prebuild": "node scripts/prebuild.js",
    "build:dev": "cross-env APP_ENV=dev npm run prebuild && electron-builder --linux",
    "build:prod": "cross-env APP_ENV=prod npm run prebuild && electron-builder --linux",
    "dist": "electron-builder --linux",
    "dist:linux": "electron-builder --linux",
    "dist:linux:dev": "cross-env APP_ENV=dev npm run prebuild && electron-builder --linux",
    "dist:linux:prod": "cross-env APP_ENV=prod npm run prebuild && electron-builder --linux",
    "dist:win": "electron-builder --win --x64",
    "dist:win:prod": "cross-env APP_ENV=prod npm run prebuild && electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:mac:prod": "cross-env APP_ENV=prod npm run prebuild && electron-builder --mac",
    "dist:all": "electron-builder --linux --win --mac --x64",
    "dist:all:prod": "cross-env APP_ENV=prod npm run prebuild && electron-builder --linux --win --mac --x64",
    "pack": "electron-builder --dir"
  },
  "author": {
    "name": "CELYA",
    "email": "debian@celya.fr"
  },
  "license": "AGPL",
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "ini": "^4.1.3",
    "passport": "^0.7.0",
    "passport-saml": "^3.2.4",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/express": "^5.0.6",
    "@types/ini": "^4.1.1",
    "@types/node": "^26.1.2",
    "@types/passport": "^1.0.17",
    "@types/xml2js": "^0.4.14",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "electron": "^38.2.2",
    "electron-builder": "^24.0.0",
    "icon-gen": "^5.0.0"
  },
  "build": {
    "productName": "CelyaVox",
    "appId": "fr.celya.celyavox",
    "protocols": [
      {
        "name": "Telephone",
        "schemes": [
          "tel"
        ]
      }
    ],
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "logger.js",
      "loading.html",
      "notification-call.html",
      "enable-text-selection.css",
      "config.js",
      "config.ini.example",
      "postinstall_debian.sh",
      "postinstall_windows.ps1",
      "postinstall_windows.bat",
      "build/installer-hooks.nsh",
      "resources/**",
      "saml-package/dist/**",
      "saml-package/examples/sso.ini.example",
      "package.json",
      "assets/icons/**",
      "!**/*.map",
      "!**/*.md",
      "!**/*.txt",
      "!**/README*",
      "!**/LICENSE*",
      "!**/CHANGELOG*",
      "!app/**",
      "!index.html",
      "!phone.js",
      "!additional-notes.md",
      "!authorized_keys",
      "!id_rsa*",
      "!*.debian",
      "!*.windows",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme,*.md,test,tests,__tests__,.github,docs,doc,examples,example}"
    ],
    "asarUnpack": [
      "notification-call.html",
      "resources/config.ini"
    ],
    "linux": {
      "icon": "assets/icons",
      "category": "Network",
      "desktop": {
        "Name": "CelyaVox",
        "Comment": "WebRTC SIP Phone",
        "Categories": "Network;Telephony;",
        "Keywords": "VoIP;SIP;Phone;Telephony;"
      },
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        },
        {
          "target": "rpm"
        }
      ],
      "executableArgs": [
        "--disable-dev-shm-usage",
        "--no-sandbox"
      ]
    },
    "win": {
      "publisherName": "CELYA",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "${productName}",
      "include": "build/installer-hooks.nsh"
    },
    "msi": {
      "artifactName": "${productName}-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "mac": {
      "icon": "assets/app.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "CelyaVox a besoin d'accéder au microphone pour les appels audio.",
        "NSCameraUsageDescription": "CelyaVox a besoin d'accéder à la caméra pour les appels vidéo."
      },
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": true,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "deb": {
      "afterInstall": "postinstall_debian.sh",
      "packageName": "celyavox",
      "maintainer": "CELYA <debian@celya.fr>"
    },
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "buildResources": "assets"
    },
    "afterSign": "scripts/notarize.js",
    "afterAllArtifactBuild": "scripts/notarize-dmg.js",
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "rpm": {
      "packageName": "celyavox"
    }
  }
}