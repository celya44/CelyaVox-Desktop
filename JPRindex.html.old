           // On va tester si le compte SIP est configuré et si non demander l'URL de provisionning
 async function fetchAndStoreXML(url) {
    try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Erreur HTTP ' + response.status);
        
        const text = await response.text();
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(text, "application/xml");
        
        // Vérifier si le XML a été parsé correctement
        if (xmlDoc.querySelector("parsererror")) {
            throw new Error("Erreur lors du parsing XML");
        }

        // Exemple : extraire des données spécifiques du XML
        // Ici on suppose que le XML contient <SipDomain>valeur</SipDomain> et <SomeKey>valeur</SomeKey>
        const sipDomainValue = xmlDoc.querySelector("SipDomain")?.textContent;
        const someKeyValue = xmlDoc.querySelector("SomeKey")?.textContent;

        if (sipDomainValue) localStorage.setItem("SipDomain", sipDomainValue);
        if (someKeyValue) localStorage.setItem("SomeKey", someKeyValue);

        alert("Données XML enregistrées avec succès !");
    } catch (err) {
        alert("Erreur lors du chargement du XML : " + err.message);
        console.error(err);
    }
}

// ============================================================
// Réinitialisation complète de la configuration
// Cette fonction efface localStorage ET les données persistées
// ============================================================
async function resetConfigurationComplete() {
    console.log('🔄 Réinitialisation complète de la configuration...');
    
    try {
        // Effacer le localStorage local
        localStorage.clear();
        console.log('✅ localStorage local effacé');
        
        // Effacer les données persistées SAML via IPC (données dans userData)
        if (window.electron && window.electron.clearAuthSession) {
            const result = await window.electron.clearAuthSession();
            if (result.success) {
                console.log('✅ Session SAML persistée effacée');
            } else {
                console.warn('⚠️ Erreur lors de l\'effacement de la session:', result.error);
            }
        } else {
            console.warn('⚠️ window.electron.clearAuthSession non disponible');
        }
        
        console.log('✅ Réinitialisation complète effectuée');
        
        // Recharger la page pour revenir à l'écran initial
        alert('Configuration réinitialisée. L\'application va recharger...');
        window.location.reload();
        
        return { success: true };
    } catch (err) {
        console.error('❌ Erreur lors de la réinitialisation:', err.message);
        alert('Erreur lors de la réinitialisation: ' + err.message);
        return { success: false, error: err.message };
    }
}

// Alias courts pour appels depuis l'app Phone
window.resetConfig = resetConfigurationComplete;
window.reinitializerConfiguration = resetConfigurationComplete;

function registerSamlListeners() {
    console.log('📌 Enregistrement des listeners SAML...');
    
    if (!window.electron || !window.electron.on) {
        console.warn('⚠️ window.electron.on non disponible');
        return;
    }
    
    // Succès SAML (canal auth:saml-success)
    window.electron.on('auth:saml-success', (result) => {
        console.log('🎉 [DEBUG] === EVENT auth:saml-success REÇU ===');
        console.log('✅ Authentification SAML réussie!');
        console.log('📥 [DEBUG] result reçu:', JSON.stringify(result, null, 2));
        console.log('👤 Utilisateur:', result.user?.name);
        console.log('⚙️ Configuration serveur - nombre d\'entrées:', Object.keys(result.config || {}).length);
        console.log('🔍 [DEBUG] Type de result.config:', typeof result.config);
        console.log('🔍 [DEBUG] result.config est undefined?', result.config === undefined);
        console.log('🔍 [DEBUG] result.config est null?', result.config === null);
        
        // Sauvegarder les informations utilisateur
        if (result.user) {
            localStorage.setItem('SamlUser', JSON.stringify(result.user));
            console.log('✅ Utilisateur sauvegardé dans localStorage');
        }
        
        // Sauvegarder la configuration depuis l'API dans localStorage
        if (result.config && typeof result.config === 'object') {
            const configKeys = Object.keys(result.config);
            console.log(`📝 Sauvegarde de ${configKeys.length} paramètres de config dans localStorage...`);
            console.log('📝 [DEBUG] Clés de config:', configKeys);
            
            let successCount = 0;
            for (const [key, value] of Object.entries(result.config)) {
                const stringValue = typeof value === 'string' ? value : JSON.stringify(value);
                localStorage.setItem(key, stringValue);
                successCount++;
                console.log(`  💾 [DEBUG] Sauvegardé: ${key} = ${stringValue.substring(0, 50)}${stringValue.length > 50 ? '...' : ''}`);
                
                if (key === 'profileName' || key === 'SipDomain' || key === 'SipUsername' || key === 'SipPassword') {
                    console.log(`  ✅ ${key} = ${stringValue.substring(0, 50)}`);
                }
            }
            console.log(`✅ ${successCount} paramètres sauvegardés dans localStorage`);
            
            // Vérifier que localStorage a reçu les données
            setTimeout(() => {
                const storedSipDomain = localStorage.getItem('SipDomain');
                console.log('🔍 Vérification localStorage après sauvegarde - SipDomain:', storedSipDomain);
                const allKeys = Object.keys(localStorage);
                console.log('🔍 [DEBUG] Toutes les clés dans localStorage:', allKeys.filter(k => !k.startsWith('_')).slice(0, 20));
            }, 100);
        } else {
            console.warn('⚠️ [DEBUG] result.config n\'est pas un objet valide');
        }
        
        // Rediriger vers l'application
        alert(`Bienvenue ${result.user?.name || 'Utilisateur'}!`);
        document.getElementById('input-container').style.display = 'none';
        // Vous pouvez ici charger l'application distante
    });
    
    // Erreur SAML
    window.electron.on('auth:saml-error', (result) => {
        console.log('\n❌❌❌ === EVENT auth:saml-error REÇU === ❌❌❌\n');
        console.error('❌ Erreur SAML:', result.error);
        console.error('[DEBUG] Erreur complète:', JSON.stringify(result, null, 2));
        alert(`Erreur d'authentification: ${result.error}`);
    });
    
    console.log('✅ Listeners SAML enregistrés');
    
    // Signaler au main process que les listeners sont prêts
    if (window.electron && window.electron.ready) {
        console.log('📢 Signal de readiness envoyé au main process');
        window.electron.ready();
    }
}

// Fonction pour lancer l'authentification SAML
async function initSamlAuth() {
    console.log('\n\n🔵🔵🔵 === FONCTION initSamlAuth() APPELÉE === 🔵🔵🔵\n');
    
    try {
        if (!window.electron || !window.electron.initSamlAuth) {
            throw new Error('API SAML non disponible');
        }
        
        console.log('[DEBUG] window.electron.initSamlAuth disponible');
        
        // Les listeners sont déjà enregistrés avant cet appel
        // Appeler le handler SAML dans main.js
        console.log('[DEBUG] Appel de window.electron.initSamlAuth()...');
        const result = await window.electron.initSamlAuth();
        console.log('[DEBUG] Réponse reçue:', result);
        
        if (!result.success) {
            throw new Error(result.error || 'Erreur inconnue lors de l\'initialisation SAML');
        }
        
        console.log('✅ Authentification SAML initialisée, en attente de l\'événement IPC...');
        
    } catch (err) {
        console.error('❌ Erreur lors de l\'initialisation SAML:', err);
        alert(`Erreur SAML: ${err.message}`);
    }
}

// Initialisation au chargement de la page
document.addEventListener('DOMContentLoaded', () => {
    console.log('\n\n🟠🟠🟠 === DOMContentLoaded DÉCLENCHÉ === 🟠🟠🟠\n');
    console.log('📄 DOM chargé - Initialisation de la détection SAML');
    
    // ⚠️ IMPORTANT: Enregistrer les listeners AVANT de faire quoi que ce soit d'autre
    console.log('[DEBUG] Appel de registerSamlListeners()');
    registerSamlListeners();
    console.log('[DEBUG] registerSamlListeners() terminé');
    
    // ============================================================
    // Restaurer la configuration passée en hash par loading.html
    // (cf. problème d'isolation du localStorage par origin)
    // ============================================================
    function restoreConfigFromHash() {
      const hash = window.location.hash;
      const hashParams = new URLSearchParams(hash.substring(1));
      const configBase64 = hashParams.get('celyavox_config');
      
      if (configBase64) {
        try {
          const configString = decodeURIComponent(atob(configBase64));
          const configData = JSON.parse(configString);
          console.log('🔄 [DEBUG] Configuration trouvée dans le hash');
          console.log('🔄 [DEBUG] Nombre de paramètres à restaurer:', Object.keys(configData).length);
          
          // Restaurer chaque paramètre dans le localStorage du nouvel origin
          for (const [key, value] of Object.entries(configData)) {
            localStorage.setItem(key, value);
            console.log(`  ✅ Restauré: ${key}`);
          }
          
          console.log('✅ Configuration SAML restaurée depuis le hash');
          
          // Nettoyer le hash pour éviter les confusions
          window.history.replaceState({}, document.title, window.location.pathname + window.location.search);
          
          return true;
        } catch (err) {
          console.error('❌ Erreur lors du décodage de la config depuis le hash:', err.message);
          return false;
        }
      } else {
        console.log('[DEBUG] Pas de celyavox_config dans le hash');
        return false;
      }
    }
    
    // Restaurer la config depuis le hash AVANT de vérifier le localStorage
    const configRestored = restoreConfigFromHash();
    
    const sipDomainStored = localStorage.getItem("SipDomain");
    console.log('[DEBUG] SipDomain dans localStorage?', !!sipDomainStored);
    if (configRestored) {
      console.log('[DEBUG] Configuration a été restaurée depuis le hash');
    }
    
    if (!sipDomainStored) {
        console.log('ℹ️ SipDomain non trouvé - Vérification du fichier sso.ini');
        
        // Vérifier si le fichier sso.ini existe
        if (window.electron && window.electron.checkSsoFile) {
            console.log('✅ API checkSsoFile disponible');
            
            window.electron.checkSsoFile().then(result => {
                console.log('📋 Résultat vérification sso.ini:', result);
                console.log('[DEBUG] result.exists?', result.exists);
                
                if (result.exists) {
                    // Le fichier sso.ini existe - lancer l'authentification SAML
                    console.log('✅ Fichier sso.ini trouvé - Lancement SAML');
                    initSamlAuth();
                } else {
                    // Le fichier sso.ini n'existe pas - afficher le formulaire
                    console.log('ℹ️ Fichier sso.ini non trouvé - Affichage du formulaire');
                    document.getElementById('input-container').style.display = 'block';
                    document.getElementById("saveBtn").addEventListener("click", () => {
                        const url = document.getElementById("sipInput").value.trim();
                        if (url) {
                            fetchAndStoreXML(url);
                            document.getElementById("input-container").style.display = "none";
                        } else {
                            alert("Veuillez entrer une URL valide.");
                        }
                    });
                }
            }).catch(err => {
                console.error('❌ Erreur lors de la vérification du fichier sso.ini:', err);
                // En cas d'erreur, afficher le formulaire
                console.log('⚠️ Fallback: Affichage du formulaire');
                document.getElementById('input-container').style.display = 'block';
                document.getElementById("saveBtn").addEventListener("click", () => {
                    const url = document.getElementById("sipInput").value.trim();
                    if (url) {
                        fetchAndStoreXML(url);
                        document.getElementById("input-container").style.display = "none";
                    } else {
                        alert("Veuillez entrer une URL valide.");
                    }
                });
            });
        } else {
            // window.electron non disponible - afficher le formulaire
            console.warn('⚠️ API window.electron non disponible');
            document.getElementById('input-container').style.display = 'block';
            document.getElementById("saveBtn").addEventListener("click", () => {
                const url = document.getElementById("sipInput").value.trim();
                if (url) {
                    fetchAndStoreXML(url);
                    document.getElementById("input-container").style.display = "none";
                } else {
                    alert("Veuillez entrer une URL valide.");
                }
            });
        }
    } else {
        console.log('✅ SipDomain trouvé dans localStorage');
    }
});
        </script>

