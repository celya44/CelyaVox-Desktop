# Configuration CelyaVox Desktop
# Fichier de configuration déployé avec l'application
# Format: INI

# REMARQUE: Les valeurs définies ici surchargeront les valeurs par défaut
# Exemple (à décommenter et modifier selon vos besoins):

# [server]
# URL du server pour le téléchargement de l'application
# serverUrl=https://celyavox.celya.fr/phone

# [app]  
# Nom de l'application affichée lors de l'utilisation
# appName=CelyaVox

# [window]
# # Taille de la fenêtre principale (pixels)
# width=1280
# height=820

# [ui]
# Interface utilisateur
# disableBuddies: Supprime le bouton "Ajouter un contact" du profil (0=activé, 1=désactivé)
# disableDoNotDisturb: Masque le bloc "Ne pas déranger (DND)" des Fonctions avancées (0=afficher, 1=masquer)
# disableCallForward: Masque le bloc "Renvoi d'appel (CFU)" des Fonctions avancées (0=afficher, 1=masquer)
# disableGUISipAccount: Masque le bloc "Compte" des paramètres (0=afficher, 1=masquer)
# disableBuddies=0
# disableDoNotDisturb=0
# disableCallForward=0
# disableGUISipAccount=0

# [audio]
# Fixer le device de sortie de sonnerie par son label
# Le label doit correspondre exactement au nom du device
# Exemple: ringerOutputLabel=Haut-parleur intégré
# Si cette option n'est pas définie, l'utilisateur peut choisir manuellement
# ringerOutputLabel=
# Fixer le volume de la sonnerie (0.0 à 1.0)
# ringerGain=1.0
