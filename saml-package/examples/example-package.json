{
  "name": "electron-saml-app",
  "version": "1.0.0",
  "description": "Electron app with SAML authentication using the reusable SAML package",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "npm run build:electron && concurrently npm:dev:*",
    "dev:electron": "wait-on http://localhost:3000 && electron --no-sandbox .",
    "dev:react": "BROWSER=none react-scripts start",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "react-scripts build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-is-dev": "^2.0.0",
    "express": "^5.2.1",
    "ini": "^4.1.1",
    "passport": "^0.7.0",
    "passport-saml": "^3.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ini": "^4.1.1",
    "@types/node": "^20.10.0",
    "@types/passport": "^1.0.17",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^8.2.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "typescript": "^4.9.5",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.sso.electron-app",
    "productName": "SAML Electron App",
    "files": [
      "dist-electron/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
